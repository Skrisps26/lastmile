# Supabase PostgreSQL connection strings.
# DATABASE_URL should use the pooled connection for application traffic.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL must use the direct database connection for Prisma migrations.
DIRECT_URL="postgresql://postgres:<password>@<direct-host>:5432/postgres?schema=public"

# Optional Supabase client configuration (only expose publishable/anon keys).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Authentication Security Secrets
JWT_SECRET="lastmile_jwt_super_secret_key_change_in_production_32char"
NEXTAUTH_SECRET="lastmile_nextauth_secret_key_min_32_characters"

# Application Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notification Provider Config (Pluggable: "mock" or "resend")
NOTIFICATION_PROVIDER="mock"
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="deliveries@lastmile.local"
